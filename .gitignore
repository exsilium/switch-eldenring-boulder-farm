# PlatformIO build output
.pio
.pio-core

# ESP-IDF managed components (fetched by the IDF component manager)
managed_components/

# IDF component manager lock file (regenerated from src/idf_component.yml)
dependencies.lock

# Generated per-env sdkconfig (regenerated from sdkconfig.defaults each build).
# Keep ONLY sdkconfig.defaults under version control.
sdkconfig.*
!sdkconfig.defaults

# Build / scratch logs
build.log
*.log

# VS Code generated/local files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/extensions.json
.vscode/ipch
